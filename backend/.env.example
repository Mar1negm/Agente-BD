PORT=3000

# OpenRouter: coloca tu clave real en un archivo .env (NO la publiques en GitHub)
OPENROUTER_API_KEY=PEGA_AQUI_TU_CLAVE
OPENROUTER_MODEL=openai/gpt-4o-mini

